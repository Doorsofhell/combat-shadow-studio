rules_version = '2';

// Combat Shadow Studio — Cloud Firestore security rules.
// Every user can only read and write their own subtree users/{uid}/**, and only once their
// e-mail address is verified (Google accounts are verified by Google). Everything else is denied.
// Deploy: firebase deploy --only firestore:rules (see docs/COMPTES.md).
service cloud.firestore {
  match /databases/{database}/documents {
    // v0.37 : la future licence Premium (users/{uid}/entitlements/*) ne pourra être écrite que par un serveur
    // de vérification des achats (Admin SDK, qui ignore ces règles) ; l'application peut seulement la lire.
    match /users/{uid}/entitlements/{doc} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
    match /users/{uid}/sync/{collection} {
      allow read, delete: if isOwner(uid);
      // one document per synchronised collection (Firestore caps a document at 1 MiB)
      allow create, update: if isOwner(uid)
        && collection in ['profile', 'stats', 'custom', 'goals', 'fighters', 'catalog']
        && request.resource.data.keys().hasAll(['schema', 'collection', 'updatedAt', 'fields', 'items'])
        && request.resource.data.schema == 1
        && request.resource.data.collection == collection;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }

  function isOwner(uid) {
    return request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
  }
}
